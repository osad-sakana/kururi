var calls: int = 0

function main = () {
    print(fact(5))
    print(average([80, 65, 91]))
    print(sign(-3))
    print(calls)
}

function fact = (n: int) -> int {
    calls += 1
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

function average = (scores: int[]) -> float {
    var sum: int = 0
    for s in scores {
        sum += s
    }
    return sum / scores.length
}

function sign = (n: int) -> int {
    if n < 0 {
        return -1
    } else if n == 0 {
        return 0
    } else {
        return 1
    }
}
