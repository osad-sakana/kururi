class Node {
    public value: int
    public next: Node? = null

    constructor(value: int) {
        self.value = value
    }
}

function findFirstLong(words: string[]): string? {
    foreach w in words {
        if w.length > 3 {
            return w
        }
    }
    return null
}

function main(): void {
    let name: string = input()
    let age: int = toInt(input())
    let found: string? = findFirstLong([name, "ab", "abcdef"])
    if found != null {
        output(`長い名前: ${found}（${found.length} 文字）`)
    } else {
        output("なし")
    }
    output(found)
    output(age > 18)

    let head: Node = new Node(1)
    head.next = new Node(2)
    let cur: Node? = head
    let sum: int = 0
    while cur != null {
        sum += cur.value
        cur = cur.next
    }
    output(sum)
    output(div(sum, 2) + random(1, 1))
}
