class Node = {
    fields = {
      public value: int
      public next: Node? = null
    }

    constructor = (value: int) {
        self.value = value
    }
}

function findFirstLong = (words: string[]) -> string? {
    for w in words {
        if w.length > 3 {
            return w
        }
    }
    return null
}

function main = () {
    var name: string = input()
    var age: int = toInt(input())
    var found: string? = findFirstLong([name, "ab", "abcdef"])
    if found != null {
        output(`長い名前: ${found}（${found.length} 文字）`)
    } else {
        output("なし")
    }
    output(found)
    output(age > 18)

    var head: Node = new Node(1)
    head.next = new Node(2)
    var cur: Node? = head
    var sum: int = 0
    while cur != null {
        sum += cur.value
        cur = cur.next
    }
    output(sum)
    output(div(sum, 2) + random(1, 1))
}
