class Node = {
    fields = {
      public value: int
      public next: Node? = null
    }

    constructor = (value: int) {
        self.value = value
    }
}

function find_first_long = (words: string[]) -> string? {
    for w in words {
        if w.length > 3 {
            return w
        }
    }
    return null
}

function main = () {
    var name: string = input()
    var age: int = to_int(input())
    var found: string? = find_first_long([name, "ab", "abcdef"])
    if found != null {
        print("長い名前: ${found}（${found.length} 文字）")
    } else {
        print("なし")
    }
    print(found)
    print(age > 18)

    var head: Node = new Node(1)
    head.next = new Node(2)
    var cur: Node? = head
    var sum: int = 0
    while cur != null {
        sum += cur.value
        cur = cur.next
    }
    print(sum)
    print(div(sum, 2) + random(1, 1))
}
