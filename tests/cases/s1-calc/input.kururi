const taxRate: float = 0.1
let 合計: int = 0

function main(): void {
    let price: int = 1200
    let count: int = 3
    let total: int = price * count
    let withTax: float = total * (1 + taxRate)
    let big: boolean = total > 3000 and not (count == 0)

    output("小計: " + toString(total))
    output(`税込: ${withTax} 円（個数 ${count}、{そのまま}）`)
    output(big)
    output(7 / 2)
    output(-7 % 3)
}
