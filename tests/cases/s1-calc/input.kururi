const TAX_RATE: float = 0.1
var 合計: int = 0

function main = () {
    var price: int = 1200
    var count: int = 3
    var total: int = price * count
    var with_tax: float = to_float(total) * (1.0 + TAX_RATE)
    var big: boolean = total > 3000 and not (count == 0)

    print("小計: " + to_string(total))
    print("税込: ${with_tax} 円（個数 ${count}、{そのまま}）")
    print(big)
    print(7 / 2)
    print(-7 % 3)
}
