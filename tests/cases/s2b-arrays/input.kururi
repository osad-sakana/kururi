const names: string[] = ["apple", "banana"]

function main = () {
    var fruits: string[] = ["apple", "banana"]
    fruits[1] = "melon"
    fruits.push("grape")
    fruits.removeAt(0)
    var count: int = fruits.length
    var weights: float[] = [1, 2.5]
    var grid: int[][] = [[1, 2], [3, 4]]
    var empty: int[] = []
    output(`${count} 個`)
    for fruit in fruits {
        output(fruit)
    }
    for row in grid {
        for v in row {
            weights.push(v)
        }
    }
    output(names[0][0])
}
