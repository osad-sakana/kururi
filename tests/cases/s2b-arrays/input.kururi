const NAMES: string[] = ["apple", "banana"]

function main = () {
    var fruits: string[] = ["apple", "banana"]
    fruits[1] = "melon"
    fruits.push("grape")
    fruits.remove_at(0)
    var count: int = fruits.length
    var weights: float[] = [1, 2.5]
    var grid: int[][] = [[1, 2], [3, 4]]
    var empty: int[] = []
    print("${count} 個")
    for fruit in fruits {
        print(fruit)
    }
    for row in grid {
        for v in row {
            weights.push(v)
        }
    }
    print(NAMES[0][0])
}
