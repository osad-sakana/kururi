class Player = {
    fields = {
      name: string
      public age: int = 20
      private nickname: string = "none"
      items: string[] = []
    }

    constructor = (name: string) {
        self.name = name
    }

    public method run = () {
        self.draw()
        self.update()
    }

    public method describe = () -> string {
        return `${self.name}（${self.age}歳）`
    }

    method draw = () {
        output("draw")
    }

    method update = () {
        self.age += 1
        self.items.push(self.nickname)
    }
}

function main = () {
    var pl: Player = new Player("taro")
    pl.run()
    output(pl.describe())
    output(pl.age)
}
