{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/cli/src",
    "packages/cli/test",
    "packages/compiler/src",
    "packages/compiler/test",
    "packages/narapy/src",
    "packages/narapy/test",
    "packages/site/test",
    "vitest.config.ts",
    "packages/lsp/src",
    "packages/lsp/test"
  ]
}
