---
import "../styles/tokens.css"
import "../styles/site.css"
import "../styles/bulb.css"
import iconUrl from "../../../../assets/logo/kururi-icon.svg?url"
import Logo from "../components/Logo.astro"
import LogoInline from "../components/LogoInline.astro"

interface Props {
  title?: string
  description?: string
  current?: "home" | "tutorials" | "spec"
  /** trueのとき、OSやプレイグラウンドの設定に関わらず、ライトテーマに固定する（トップ用） */
  lightOnly?: boolean
  /** falseのとき、フッターを出さない（チュートリアル用） */
  footer?: boolean
}

const { lightOnly = false, footer = true, title, description = "Kururiは、プログラミングの概念を学ぶことに特化した最初の言語です。ここで身につければ、多くの言語への入り口になります。", current } = Astro.props
const base = import.meta.env.BASE_URL
const home = base.endsWith("/") ? base : `${base}/`
const pageTitle = title === undefined ? "「Kururi」は学習用プログラミング言語！" : `${title} | Kururi`
---

<!doctype html>
<html lang="ja" data-theme={lightOnly ? "light" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={iconUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=0xProto:ital,wght@0,400;0,700;1,400&family=Noto+Sans+JP:wght@400;500;700;800&family=Jost:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- プレイグラウンドで選んだ見た目（ライト / ダーク）を、ちらつかせずに引き継ぐ -->
    <script is:inline>
      document.documentElement.classList.add("js")
      try {
        var theme = localStorage.getItem("kururi.theme")
        if (!document.documentElement.dataset.theme && (theme === "light" || theme === "dark")) document.documentElement.dataset.theme = theme
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={home} aria-label="Kururiのトップへ"><Logo animated /></a>
        <nav aria-label="サイト内">
          <a href={`${home}tutorials`} aria-current={current === "tutorials" ? "page" : undefined}>チュートリアル</a>
          <a href={`${home}spec`} aria-current={current === "spec" ? "page" : undefined}>言語仕様</a>
          <a href={`${home}playground`}>プレイグラウンド</a>
          <a class="icon-link" href="https://github.com/osad-sakana/kururi" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" /></svg></a>
        </nav>
      </div>
    </header>
    <slot />
    {footer && (<footer class="site-footer">
      <div class="wrap">
        <span>「<LogoInline />」は学習用プログラミング言語！</span>
        <a href={`${home}tutorials`}>チュートリアル</a>
        <a href={`${home}spec`}>言語仕様</a>
        <a href={`${home}playground`}>プレイグラウンド</a>
        <a class="icon-link" href="https://github.com/osad-sakana/kururi" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" /></svg></a>
      </div>
    </footer>)}
  </body>
</html>
