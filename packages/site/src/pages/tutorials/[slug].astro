---
import { getCollection, render } from "astro:content"
import Base from "../../layouts/Base.astro"
import BulbSpinner from "../../components/BulbSpinner.astro"

export async function getStaticPaths() {
  const lessons = (await getCollection("tutorials")).sort((a, b) => a.data.order - b.data.order)
  return lessons.map((lesson, index) => ({
    params: { slug: lesson.id.replace(/^\d+-/, "") },
    props: { lesson, previous: lessons[index - 1], next: lessons[index + 1] },
  }))
}

const { lesson, previous, next } = Astro.props
const { Content } = await render(lesson)
const base = import.meta.env.BASE_URL
const home = base.endsWith("/") ? base : `${base}/`
const slugOf = (id: string) => id.replace(/^\d+-/, "")
---

<Base title={lesson.data.title} current="tutorials" lightOnly footer={false} description={lesson.data.summary}>
  <!-- 横に開くプレイグラウンドでinput() を使えるよう、必要なヘッダーをサービスワーカーで付ける（MIT） -->
  <script is:inline slot="head" src={`${home}coi-serviceworker.js`}></script>
  <div class="reader" data-playground={`${home}playground`}>
    <main class="wrap prose">
      <p class="crumb"><a href={home}>トップ</a> / <a href={`${home}tutorials`}>チュートリアル</a> / 第 {lesson.data.order} 回</p>
      <p class="crumb">学ぶ概念：{lesson.data.concept}</p>
      <h1>{lesson.data.title}</h1>
      <p class="lead">{lesson.data.summary}</p>
      <Content />
      <nav class="pager" aria-label="前後の回">
        {previous !== undefined ? (
          <a href={`${home}tutorials/${slugOf(previous.id)}`}><small>前の回</small>{previous.data.title}</a>
        ) : <span />}
        {next !== undefined ? (
          <a class="next" href={`${home}tutorials/${slugOf(next.id)}`}><small>次の回</small>{next.data.title}</a>
        ) : (
          <a class="next" href={`${home}playground`}><small>つづき</small>プレイグラウンドで自由に書く</a>
        )}
      </nav>
    </main>
    <aside class="side" aria-label="プレイグラウンド">
      <div class="side-resize" role="separator" aria-orientation="vertical" aria-label="幅を変える"></div>
      <div class="side-bar">
        <strong>PLAYGROUND</strong>
        <a href={`${home}playground`} target="_blank" rel="noopener">別のタブで開く</a>
        <button type="button" class="side-close">閉じる</button>
      </div>
      <div class="side-loading"><BulbSpinner class="side-bulb" /><span>読み込み中…</span></div>
      <iframe title="プレイグラウンド" allow="cross-origin-isolated"></iframe>
    </aside>
  </div>
  <button type="button" class="side-toggle">プレイグラウンドを開く</button>
  <script>
    const WIDTH_KEY = "kururi.panelWidth"
    const reader = document.querySelector<HTMLElement>(".reader")
    const iframe = document.querySelector<HTMLIFrameElement>(".side iframe")
    const toggle = document.querySelector<HTMLButtonElement>(".side-toggle")
    const closeButton = document.querySelector<HTMLButtonElement>(".side-close")
    const resize = document.querySelector<HTMLElement>(".side-resize")
    const target = reader?.dataset.playground ?? "/playground"
    iframe?.addEventListener("load", () => iframe.closest(".side")?.classList.add("loaded"))
    const store = {
      get: (key: string) => { try { return localStorage.getItem(key) } catch { return null } },
      set: (key: string, value: string) => { try { localStorage.setItem(key, value) } catch { /* 保存できなくても使える */ } },
    }

    // ヘッダーの高さに合わせる
    const header = document.querySelector<HTMLElement>(".site-header")
    if (reader && header) reader.style.setProperty("--hh", `${header.offsetHeight}px`)

    const savedWidth = Number(store.get(WIDTH_KEY))
    if (reader && Number.isFinite(savedWidth) && savedWidth >= 360) reader.style.setProperty("--panel", `${savedWidth}px`)

    /** パネルを開く（コードは入れない。初回だけ読み込む） */
    const open = () => {
      if (!reader || !iframe) return
      reader.classList.add("open")
      if (iframe.src === "") iframe.src = `${target}?embed=1`
    }
    const close = () => {
      reader?.classList.remove("open")
    }
    toggle?.addEventListener("click", open)
    closeButton?.addEventListener("click", close)

    // 幅をドラッグで変える
    resize?.addEventListener("pointerdown", (event) => {
      if (!reader) return
      event.preventDefault()
      reader.classList.add("dragging")
      const move = (e: PointerEvent) => {
        const width = Math.min(Math.max(innerWidth - e.clientX, 360), innerWidth * 0.72)
        reader.style.setProperty("--panel", `${width}px`)
        store.set(WIDTH_KEY, String(Math.round(width)))
      }
      const stop = () => {
        reader.classList.remove("dragging")
        removeEventListener("pointermove", move)
        removeEventListener("pointerup", stop)
      }
      addEventListener("pointermove", move)
      addEventListener("pointerup", stop)
    })

    // チュートリアルを開いたら、広い画面では横にプレイグラウンドを開く（コードは自動で入れない）
    if (innerWidth > 1100) open()
  </script>
</Base>
