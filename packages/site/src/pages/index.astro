---
import "../styles/landing.css"
import { compile, formatDiagnostics } from "@kururi/compiler"
import { getCollection } from "astro:content"
import Base from "../layouts/Base.astro"
import Logo from "../components/Logo.astro"
import LogoInline from "../components/LogoInline.astro"
import { LANGUAGES } from "../data/languages"
import { renderInline } from "../data/inline"

const base = import.meta.env.BASE_URL
const home = base.endsWith("/") ? base : `${base}/`
const slugOf = (id: string) => id.replace(/^\d+-/, "")
const lessons = (await getCollection("tutorials")).sort((a, b) => a.data.order - b.data.order)

// ---- ヒーローの図：中心のロゴ（概念）を、内側の概念と外側の言語がつなぐ ----
const CENTER = 260
const polar = (radius: number, angle: number): [number, number] => [CENTER + radius * Math.cos(angle), CENTER + radius * Math.sin(angle)]
const concepts = ["型", "名前", "分岐", "繰り返し", "関数", "配列", "null"]
const languages = ["Python", "TypeScript", "Java", "Rust", "Go", "Swift", "C#", "Kotlin"]
const conceptNodes = concepts.map((label, i) => ({ label, at: polar(118, -Math.PI / 2 + (i * 2 * Math.PI) / concepts.length), width: label === "null" ? 52 : 22 + label.length * 15 }))
const languageNodes = languages.map((label, i) => ({ label, at: polar(214, -Math.PI / 2 + Math.PI / languages.length + (i * 2 * Math.PI) / languages.length), width: 26 + label.length * 8.6 }))
const links = languageNodes.flatMap((language, i) => [conceptNodes[i % concepts.length], conceptNodes[(i + 3) % concepts.length]].map((concept) => ({ from: language.at, to: concept!.at })))

// ---- ヒーローのコード例（Python は、コンパイラが実際に出したもの）----
const heroSource = `function main = () {
    var names: string[] = ["さくら", "たろう"]
    for name in names {
        print(\`こんにちは、\${name}さん\`)
    }
}
`
const heroCompiled = compile(heroSource)
const heroPython = heroCompiled.python.replace(/\n+$/, "")
const heroOutput = ["こんにちは、さくらさん", "こんにちは、たろうさん"]
const escapeCode = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
/** 色付けは、字句ごとの簡単なもの（キーワード・型・文字列・数）。 */
const highlight = (code: string) =>
  escapeCode(code).replace(/(`[^`]*`|"[^"]*")|\b(function|var|const|for|in|if|else|return|class|def|print|while)\b|\b(int|string|float|boolean|list|str)\b|\b(\d+)\b/g, (match, str, kw, ty, num) =>
    str !== undefined ? `<span class="s">${match}</span>` : kw !== undefined ? `<span class="k">${match}</span>` : ty !== undefined ? `<span class="y">${match}</span>` : num !== undefined ? `<span class="n">${match}</span>` : match,
  )
const heroKururiLines = heroSource.replace(/\n+$/, "").split("\n").map(highlight)
const heroPythonLines = heroPython.split("\n").map(highlight)

// ---- 学び方：画面図の番号と、説明（番号の位置から線を伸ばす）----
const flowItems = [
  { n: 1, title: "読む", text: "チュートリアルで、概念を 1 つずつ。コードはボタン 1 つで、横のプレイグラウンドに届きます。", x: 10.4, y: 5.75, width: 27 },
  { n: 2, title: "書く", text: "書くそばから、エラーと直し方が出ます。変換後の Python も、横に並べて見られます。", x: 39.6, y: 17.75, width: 31 },
  { n: 3, title: "確かめる", text: "ステップ実行で、1 行ずつ進めながら、変数の値が変わる様子を目で追えます。", x: 72.9, y: 17.75, width: 27 },
]

// ---- 理由 1 の図：AI が書き、人が読んで直す ----
const codeBars = [70, 120, 96, 58, 132, 84, 110, 46]

// ---- 本物のエラー（コンパイラが出したものをそのまま見せる）----
const badSource = `function main = () {
    var count: int = "three"
    print(count)
}
`
const badDiagnostics = compile(badSource).diagnostics
const errorText = formatDiagnostics(badDiagnostics, { source: badSource, fileName: "main.kururi" }).trim()
const escapeHtml = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
const errorHtml = escapeHtml(errorText)
  .replace(/^(error\[[A-Z0-9]+\])/m, '<span class="e">$1</span>')
  .replace(/^(help:)/m, '<span class="h">$1</span>')
  .split("\n")
  .map((line, i) => `<span class="ln" style="--n:${i}">${line}</span>`)
  .join("")
---

<Base current="home" lightOnly description="AI がコードを書く時代の、新しいプログラミング入門。Kururi は、プログラミングの概念を学ぶことに特化した最初の言語です。">
  <main class="lp">
    <!-- ヒーロー -->
    <section class="lp-hero">
      <div class="bg" aria-hidden="true"><div class="blob b1"></div><div class="blob b2"></div><div class="dots"></div></div>
      <div class="wrap">
        <div>
          <Logo animated class="hero-logo fade-up" />
          <h1>
            <span class="line"><span style="--i: 0">AI 時代の、</span></span>
            <span class="line"><span style="--i: 1">最初の</span></span>
            <span class="line"><span style="--i: 2"><em>プログラミング言語</em>。</span></span>
          </h1>
          <p class="lead fade-up" style="--i: 5">
            書くのは AI。読んで、直して、決めるのは あなた。そのために要るのは、書き方の暗記ではなく<strong>概念の理解</strong>です。
            <LogoInline /> は、その概念を学ぶことに特化した、最初の言語。ここで身につければ、どの言語への入り口にもなります。
          </p>
          <div class="actions fade-up" style="--i: 6">
            <a class="button primary" href={`${home}tutorials`}>チュートリアルをはじめる</a>
            <a class="button" href={`${home}playground`}>プレイグラウンドで書く</a>
          </div>
          <p class="official fade-up" style="--i: 7">「<LogoInline />」は学習用プログラミング言語！</p>
        </div>
        <div class="hero-code" aria-label="Kururi のコードと、変換後の Python の例">
          <div class="hc-card">
            <div class="hc-bar"><i></i><i></i><i></i><span>main.kururi</span></div>
            <pre class="hc-pre">{heroKururiLines.map((line, i) => <span class="cl" style={`--n:${i}`} set:html={line === "" ? " " : line} />)}</pre>
          </div>
          <div class="hc-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 40"><path pathLength="1" d="M12 2 V34 M5 27 L12 35 L19 27" /></svg>
            <span>Python に変換</span>
          </div>
          <div class="hc-card hc-py">
            <div class="hc-bar"><i></i><i></i><i></i><span>main.py</span></div>
            <pre class="hc-pre">{heroPythonLines.map((line, i) => <span class="pl" style={`--n:${i}`} set:html={line === "" ? " " : line} />)}</pre>
            <div class="hc-out">
              {heroOutput.map((line, i) => <span class="ol" style={`--n:${i}`}>{line}</span>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- なぜ、概念なのか -->
    <section class="why" id="why">
      <div class="wrap">
        <div class="intro">
          <div data-reveal>
            <p class="kicker">Why concepts</p>
            <h2>なぜ、概念なのか</h2>
            <p class="body">文法を覚える時代は、終わりつつあります。これから必要なのは、AI が出したものを、理解して使いこなす力です。</p>
            <p class="body">概念とは、型、名前、分岐、繰り返し、関数、データのまとまり、「値がない」こと。中心にこれらがあり、まわりに、いろいろな言語があります。</p>
          </div>
        <div class="orbit-wrap" data-reveal="200">
          <svg class="orbit" viewBox="0 0 520 520" role="img" aria-label="中心の Kururi が、型・名前・分岐などの概念と、Python や TypeScript などの言語をつないでいる図">
            <defs>
              <linearGradient id="core-bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0e7490" /><stop offset="1" stop-color="#164e63" /></linearGradient>
              <radialGradient id="halo-g"><stop offset="0" stop-color="#fbbf24" stop-opacity="0.45" /><stop offset="1" stop-color="#fbbf24" stop-opacity="0" /></radialGradient>
            </defs>
            <circle class="halo" cx={CENTER} cy={CENTER} r="120" fill="url(#halo-g)" />
            <g class="spin">
              <circle class="stroke ring" cx={CENTER} cy={CENTER} r="118" />
              <circle class="stroke ring slow" cx={CENTER} cy={CENTER} r="214" />
              {links.map((link) => (
                <line class="stroke link" x1={link.from[0]} y1={link.from[1]} x2={link.to[0]} y2={link.to[1]} />
              ))}
              {conceptNodes.map((node) => (
                <g transform={`translate(${node.at[0]} ${node.at[1]})`}>
                  <g class="upright">
                    <rect x={-node.width / 2} y="-15" width={node.width} height="30" rx="15" class="panel" style="stroke: var(--color-spark)" />
                    <text class="t" y="5" text-anchor="middle" font-size="14" font-weight="700">{node.label}</text>
                  </g>
                </g>
              ))}
              {languageNodes.map((node) => (
                <g transform={`translate(${node.at[0]} ${node.at[1]})`}>
                  <g class="upright">
                    <rect x={-node.width / 2} y="-15" width={node.width} height="30" rx="15" class="panel" />
                    <text class="m" y="5" text-anchor="middle" font-size="13">{node.label}</text>
                  </g>
                </g>
              ))}
            </g>
            <g transform={`translate(${CENTER - 48} ${CENTER - 56}) scale(1.5)`}>
              <rect width="64" height="64" rx="14" fill="url(#core-bg)" />
              <g class="core-bulb" transform="translate(32 16) scale(1.2) rotate(180 0 7)">
                <g fill="none" stroke="#fbbf24" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M-6 0V4A11 11 0 1 0 6 4V0Z" />
                  <path d="M-5 -5H5M-3 -10H3" />
                </g>
              </g>
            </g>
            <text class="t" x={CENTER} y={CENTER + 74} text-anchor="middle" font-size="15" font-weight="800" letter-spacing="3">概念</text>
          </svg>
        </div>
        </div>

        <div class="reason" data-reveal>
          <div class="reason-text">
            <div class="no">01</div>
            <h3>書くのは AI の得意技になった。</h3>
            <p><strong>人に残るのは、出てきたコードを読み、直し、指示する力です。</strong></p>
            <p>動くコードを書く作業は、AI に任せられます。でも、それが正しいか、意図に合っているかを決めるのは、人です。</p>
          </div>
          <figure>
            <svg viewBox="0 0 540 330" role="img" aria-label="AI が書いたコードを、人が読み、直し、指示する図">
              <g>
                <rect x="0" y="52" width="210" height="238" rx="16" class="editor" />
                <rect x="14" y="68" width="8" height="8" rx="4" class="bar" /><rect x="28" y="68" width="8" height="8" rx="4" class="bar" /><rect x="42" y="68" width="8" height="8" rx="4" class="bar" />
                {codeBars.map((width, i) => (
                  <rect class="grow" style={`--i:${i}; --base:300`} x={i % 3 === 1 ? 44 : 28} y={100 + i * 22} width={width} height="9" rx="4.5" fill={i === 4 ? "var(--color-spark)" : "var(--color-line)"} />
                ))}
                <g class="pop" style="--base: 100">
                  <rect x="0" y="0" width="116" height="34" rx="17" class="panel" style="stroke: var(--color-spark)" />
                  <text class="t" x="58" y="22" text-anchor="middle" font-size="14" font-weight="700">AI が書く</text>
                </g>
              </g>
              <path class="draw stroke-sp" pathLength="1" style="--base: 1200" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M228 170 H292 M278 156 L292 170 L278 184" />
              <g transform="translate(330 0)">
                <rect x="0" y="52" width="210" height="238" rx="16" class="editor" />
                <rect x="14" y="68" width="8" height="8" rx="4" class="bar" /><rect x="28" y="68" width="8" height="8" rx="4" class="bar" /><rect x="42" y="68" width="8" height="8" rx="4" class="bar" />
                {codeBars.map((width, i) => (
                  <rect class="grow" style={`--i:${i}; --base:1500`} x={i % 3 === 1 ? 44 : 28} y={100 + i * 22} width={width} height="9" rx="4.5" fill={i === 4 ? "var(--color-spark)" : "var(--color-line)"} />
                ))}
                <rect class="pop scan" style="--base: 2300; fill: none; stroke: var(--color-spark); stroke-width: 1.6; stroke-dasharray: 4 4" x="14" y="192" width="182" height="24" rx="6" />
                <circle class="pop" style="--base: 2700" cx="176" cy="252" r="20" fill="var(--color-panel)" stroke="var(--color-spark)" stroke-width="2" />
                <path class="draw stroke-sp" pathLength="1" style="--base: 3000" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M167 252 l7 7 l13 -15" />
                <g class="pop" style="--base: 1400">
                  <rect x="0" y="0" width="210" height="34" rx="17" class="panel" style="stroke: var(--color-spark)" />
                  <text class="t" x="105" y="22" text-anchor="middle" font-size="14" font-weight="700">読む・直す・指示する</text>
                </g>
              </g>
            </svg>
          </figure>
        </div>

        <div class="reason" data-reveal>
          <div class="reason-text">
            <div class="no">02</div>
            <h3>その力の土台は、文法ではなく概念。</h3>
            <p><strong>型、名前、分岐、繰り返し、関数、データのまとまり、「値がない」こと。</strong></p>
            <p>書き方は言語ごとに違います。でも、その下にある概念は、言語が変わってもほぼそのまま通じます。</p>
          </div>
          <figure>
            <svg viewBox="0 0 540 330" role="img" aria-label="言語ごとに違う書き方が、共通の概念「関数」に集まる図">
              <text class="t dim" x="0" y="14" font-size="12" letter-spacing="2">文法 — 言語ごとに違う</text>
              {[
                { name: "Python", code: "def add(a, b):", x: 0 },
                { name: "Java", code: "int add(int a)", x: 136 },
                { name: "TypeScript", code: "add(a: number)", x: 272 },
                { name: "Rust", code: "fn add(a: i32)", x: 408 },
              ].map((chip, i) => (
                <g>
                  <g class="pop" style={`--i:${i}; --base:150`}>
                    <rect x={chip.x} y="26" width="128" height="62" rx="12" class="editor" />
                    <text class="m dim" x={chip.x + 12} y="46" font-size="10">{chip.name}</text>
                    <text class="m" x={chip.x + 12} y="70" font-size="9.5">{chip.code}</text>
                  </g>
                  <path class="draw stroke-sp" pathLength="1" style={`--i:${i}; --base:700`} stroke-width="1.8" d={`M${chip.x + 64} 88 C ${chip.x + 64} 150, 270 150, 270 196`} />
                </g>
              ))}
              <text class="t dim" x="0" y="190" font-size="12" letter-spacing="2">概念 — 共通</text>
              <g class="pop glow-box" style="--base: 1700">
                <rect x="100" y="204" width="340" height="68" rx="16" class="panel" style="stroke: var(--color-spark); stroke-width: 2" />
                <text class="t" x="270" y="232" text-anchor="middle" font-size="17" font-weight="800">関数</text>
                <text class="t dim" x="270" y="256" text-anchor="middle" font-size="13">入力を受け取り、結果を返す</text>
              </g>
            </svg>
          </figure>
        </div>

        <div class="reason" data-reveal>
          <div class="reason-text">
            <div class="no">03</div>
            <h3>だから、概念に集中できる言語を最初に。</h3>
            <p><strong><LogoInline /> は文法を最小にして、1 つの概念を 1 つの形で見せます。</strong></p>
            <p>間違えたときは、必ず直し方を添えたエラーで教えます。迷わず、概念だけに向き合えます。</p>
          </div>
          <figure>
            <svg viewBox="0 0 540 330" role="img" aria-label="値の種類、分岐、繰り返し、関数が、それぞれ 1 つの形に対応している図">
              <text class="t dim" x="0" y="14" font-size="12" letter-spacing="2">1 つの概念 ＝ 1 つの形</text>
              {[
                { concept: "値の種類", code: "var age: int = 12" },
                { concept: "分岐", code: "if age >= 20 { … }" },
                { concept: "繰り返し", code: "for i in 0..3 { … }" },
                { concept: "関数", code: "function f = () { … }" },
              ].map((row, i) => (
                <g transform={`translate(0 ${34 + i * 70})`}>
                  <g class="slide" style={`--i:${i}; --base:200`}>
                    <rect x="0" y="0" width="150" height="52" rx="26" class="panel" style="stroke: var(--color-spark)" />
                    <text class="t" x="75" y="32" text-anchor="middle" font-size="16" font-weight="700">{row.concept}</text>
                  </g>
                  <path class="draw stroke-sp" pathLength="1" style={`--i:${i}; --base:700`} stroke-width="2" stroke-linecap="round" d="M158 26 H214" />
                  <circle class="pop sp" style={`--i:${i}; --base:1100`} cx="218" cy="26" r="4" />
                  <g class="slide" style={`--i:${i}; --base:1200`}>
                    <rect x="228" y="0" width="300" height="52" rx="14" class="editor" />
                    <text class="m" x="248" y="31" font-size="15">{row.code}</text>
                  </g>
                </g>
              ))}
            </svg>
          </figure>
        </div>
      </div>
    </section>

    <!-- 同じ概念、どの言語でも -->
    <section class="same">
      <div class="wrap">
        <div class="head" data-reveal>
          <p class="kicker">Same idea, any language</p>
          <h2>書き方は違っても、<br />考え方は同じ。</h2>
          <p class="body">「関数」を、4 つの言語で書いてみます。色が付いた部分が、共通する概念の部品です。</p>
        </div>
        <div class="snippets" data-reveal>
          <div class="snippet kururi">
            <h4><LogoInline /></h4>
            <pre set:html={`function <mark class="n" style="--k:0">add</mark> = (<mark class="a" style="--k:1">a: int, b: int</mark>) -> <mark class="r" style="--k:2">int</mark> {\n    return a + b\n}`} />
          </div>
          <div class="snippet">
            <h4>PYTHON</h4>
            <pre set:html={`def <mark class="n" style="--k:0">add</mark>(<mark class="a" style="--k:1">a: int, b: int</mark>) -> <mark class="r" style="--k:2">int</mark>:\n    return a + b`} />
          </div>
          <div class="snippet">
            <h4>TYPESCRIPT</h4>
            <pre set:html={`function <mark class="n" style="--k:0">add</mark>(<mark class="a" style="--k:1">a: number, b: number</mark>): <mark class="r" style="--k:2">number</mark> {\n  return a + b\n}`} />
          </div>
          <div class="snippet">
            <h4>JAVA</h4>
            <pre set:html={`static <mark class="r" style="--k:2">int</mark> <mark class="n" style="--k:0">add</mark>(<mark class="a" style="--k:1">int a, int b</mark>) {\n    return a + b;\n}`} />
          </div>
        </div>
        <p class="legend" data-reveal="300"><span><mark class="n">名前</mark> 呼ぶときの名前</span><span><mark class="a">引数</mark> 受け取る値と、その型</span><span><mark class="r">戻り値</mark> 返す値の型</span></p>
      </div>
    </section>

    <!-- 学び方 -->
    <section class="how">
      <div class="wrap">
        <div class="head" data-reveal>
          <p class="kicker">How you learn</p>
          <h2>読んで、書いて、<br />動きを目で確かめる。</h2>
          <p class="body">ブラウザだけで、書く・動かす・確かめるまでできます。インストールは要りません。</p>
        </div>
        <div class="window annot" data-reveal>
          <div class="shot">
          <svg id="demo" viewBox="0 0 960 400" role="img" aria-label="ステップ実行の画面。コードの 1 行が光り、そのときの変数の値が右に表示される">
            <rect x="1" y="1" width="958" height="398" rx="18" class="editor" />
            <rect x="1" y="1" width="958" height="44" rx="18" class="panel" />
            <rect x="1" y="30" width="958" height="15" class="panel" style="stroke: none" />
            <line x1="1" y1="45" x2="959" y2="45" class="stroke" />
            <circle cx="26" cy="23" r="6" fill="#ed5350" /><circle cx="46" cy="23" r="6" fill="#fbbf24" /><circle cx="66" cy="23" r="6" fill="#45b164" />
            <text class="t dim" x="480" y="28" text-anchor="middle" font-size="13">プレイグラウンド</text>
            <rect x="100" y="11" width="206" height="24" rx="12" class="panel" />
            <text class="t dim" x="203" y="28" text-anchor="middle" font-size="12">チュートリアル 04 のコード</text>
            <g class="badge"><circle cx="100" cy="23" r="14" /><text x="100" y="23">1</text></g>
            <line x1="500" y1="45" x2="500" y2="399" class="stroke" />
            <text class="m dim" x="28" y="76" font-size="11" letter-spacing="2">KURURI</text>
            <g class="badge"><circle cx="380" cy="71" r="14" /><text x="380" y="71">2</text></g>
            <rect id="demo-hl" class="demo-hl" x="2" y="0" width="497" height="32" style="transform: translateY(88px)" />
            {[
              "function main = () {",
              "    var total: int = 0",
              "    for i in 0..4 {",
              "        total = total + i",
              "    }",
              "    print(total)",
              "}",
            ].map((line, i) => (
              <g>
                <text class="m dim" x="28" y={98 + i * 36 + 12} font-size="13">{i + 1}</text>
                <text class="m" x="64" y={98 + i * 36 + 12} font-size="16">{line}</text>
              </g>
            ))}
            <text class="m dim" x="528" y="76" font-size="11" letter-spacing="2">ステップ実行</text>
            <g class="badge"><circle cx="700" cy="71" r="14" /><text x="700" y="71">3</text></g>
            {["最初へ", "戻る", "進む", "最後へ"].map((label, i) => (
              <g class="demo-btn" id={i === 2 ? "demo-next" : undefined}>
                <rect x={528 + i * 78} y="92" width="68" height="30" rx="8" class="panel" style={i === 2 ? "stroke: var(--color-spark)" : ""} />
                <text class="t" x={528 + i * 78 + 34} y="112" text-anchor="middle" font-size="12">{label}</text>
              </g>
            ))}
            <text id="demo-count" class="m dim" x="528" y="158" font-size="13">1 / 7　main　2 行目（この行を実行する前）</text>
            <text class="m dim" x="528" y="200" font-size="12">変数</text><text class="m dim" x="650" y="200" font-size="12">型</text><text class="m dim" x="730" y="200" font-size="12">値</text>
            <line x1="528" y1="210" x2="930" y2="210" class="stroke" />
            <g id="demo-v1" class="demo-var" opacity="0"><text id="demo-n1" class="m sp" x="528" y="238" font-size="16">total</text><text class="m" x="650" y="238" font-size="16">int</text><text id="demo-x1" class="m demo-val" x="730" y="238" font-size="16" font-weight="700">0</text></g>
            <g id="demo-v2" class="demo-var" opacity="0"><text id="demo-n2" class="m sp" x="528" y="274" font-size="16">i</text><text class="m" x="650" y="274" font-size="16">int</text><text id="demo-x2" class="m demo-val" x="730" y="274" font-size="16" font-weight="700">0</text></g>
            <text class="m dim" x="528" y="338" font-size="11" letter-spacing="2">出力</text>
            <text id="demo-out" class="m" x="528" y="364" font-size="14" opacity="0.6">（まだ何も出ていません）</text>
          </svg>
          {flowItems.map((item, i) => (
            <div class="note" style={`left:${item.x}%; width:${item.width}%; --y:${item.y}%; --d:${400 + i * 250}`}>
              <h3><span class="n">{item.n}</span>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))}
          </div>
        </div>
        <ol class="flow flow-mobile">
          {flowItems.map((item) => (
            <li>
              <span class="num">{item.n}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- エラーは先生 -->
    <section class="teach">
      <div class="wrap">
        <div data-reveal>
          <p class="kicker">Errors that teach</p>
          <h2>エラーは、<br />先生になる。</h2>
          <p class="body">
            「なぜ弾かれたか分からない」を、なくします。何が、どこで、なぜ間違いで、どう直せばよいか。<strong>必ず、直し方を添えて</strong>教えます。
          </p>
        </div>
        <div class="terminal" data-reveal id="term" aria-label="Kururi が実際に出すエラーの例">
          <div class="bar"><i></i><i></i><i></i><span style="margin-left: 0.4rem">main.kururi</span></div>
          <div class="screen">
            <pre set:html={errorHtml} />
          </div>
          <div class="fix">これは実際に Kururi が出すエラーです</div>
        </div>
      </div>
    </section>

    <!-- 8 回のコース -->
    <section class="course">
      <div class="wrap">
        <div class="head" data-reveal>
          <p class="kicker">Course</p>
          <h2>8 回で、概念をひとまわり。</h2>
          <p class="body">手順から始めて、値と型、分岐、繰り返し、関数、配列、クラス、そして「値がない」こと。順番に進めば、プログラミングの土台がそろいます。</p>
        </div>
        <nav class="path" data-reveal aria-label="チュートリアルの一覧">
          {lessons.map((lesson, i) => (
            <a style={`--i:${i}`} href={`${home}tutorials/${slugOf(lesson.id)}`}>
              {lesson.data.title}
              <small>{lesson.data.concept}</small>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <!-- どの言語で役立つか -->
    <section class="langs-sec" id="languages">
      <div class="wrap">
        <div class="head" data-reveal>
          <p class="kicker">Where it helps</p>
          <h2>どの言語で、役立つか。</h2>
          <p class="body">どの言語でも変わらないのは「考え方」の部分です。書き方（記号や語順）は言語ごとに違うので、そこは新しい言語で改めて覚えます。</p>
        </div>
        <div class="table-scroll">
          <table class="langs">
            <thead>
              <tr><th>言語</th><th>そのまま通じること</th><th>違うこと（最初に戸惑う点）</th></tr>
            </thead>
            <tbody>
              {LANGUAGES.map((row) => (
                <tr>
                  <td><span class="ext">{row.ext}</span><span class="lang-name">{row.name}</span></td>
                  <td set:html={renderInline(row.shared)} />
                  <td set:html={renderInline(row.differs)} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 扱わないこと -->
    <section>
      <div class="wrap scope" data-reveal>
        <p class="kicker">Scope</p>
        <h2>「入り口」であって、「全部」ではない。</h2>
        <p class="body"><LogoInline /> が扱うのは、多くの言語に共通する、土台の概念です。次のものは、扱いません。</p>
        <ul>
          <li>ラムダ・クロージャ（関数を値として扱うこと）、ジェネリクス</li>
          <li>非同期・並行処理、メモリ管理</li>
          <li>継承・ポリモーフィズム（入り口としては、カプセル化まで）</li>
        </ul>
        <p class="body" style="margin-top: 1.2rem">実用言語になることは目指さない、学習用の言語です。</p>
      </div>
    </section>

    <!-- 終わりに -->
    <section class="cta">
      <div class="bg" aria-hidden="true"></div>
      <svg class="swirl" viewBox="-40 -40 80 80" aria-hidden="true"><path class="stroke-ac" stroke-width="1.2" stroke-linecap="round" fill="none" d="M0 0 a5 5 0 0 1 5 5 a10 10 0 0 1 -10 10 a15 15 0 0 1 -15 -15 a20 20 0 0 1 20 -20 a25 25 0 0 1 25 25 a30 30 0 0 1 -30 30 a35 35 0 0 1 -35 -35" /></svg>
      <div class="wrap">
        <div data-reveal>
          <Logo animated class="cta-logo" />
          <h2>まず、1 行、書いてみよう。</h2>
          <p class="body" style="margin-inline: auto">ブラウザだけで、いますぐ始められます。</p>
          <div class="actions">
            <a class="button primary" href={`${home}tutorials`}>チュートリアルをはじめる</a>
            <a class="button" href={`${home}playground`}>プレイグラウンドで書く</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <script>
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches

    // ---- スクロールで現れる ----
    const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]")
    reveals.forEach((el) => {
      const delay = Number(el.dataset.reveal)
      if (Number.isFinite(delay) && delay > 0) el.style.setProperty("--d", String(delay))
    })
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          entry.target.classList.add("in")
          reveal.unobserve(entry.target)
        }
      },
      { threshold: 0.16, rootMargin: "0px 0px -6% 0px" },
    )
    reveals.forEach((el) => reveal.observe(el))

    // ---- ステップ実行のデモ（見えているあいだ、1 歩ずつ進める）----
    type Row = readonly [string, string]
    interface Step { readonly line: number; readonly vars: readonly Row[]; readonly out?: string }
    const steps: readonly Step[] = [
      { line: 2, vars: [] },
      { line: 3, vars: [["total", "0"]] },
      { line: 4, vars: [["total", "0"], ["i", "0"]] },
      { line: 4, vars: [["total", "0"], ["i", "1"]] },
      { line: 4, vars: [["total", "1"], ["i", "2"]] },
      { line: 4, vars: [["total", "3"], ["i", "3"]] },
      { line: 6, vars: [["total", "6"], ["i", "3"]], out: "6" },
    ]
    const q = <T extends Element>(id: string) => document.getElementById(id) as unknown as T | null
    const demo = { hl: q<SVGElement>("demo-hl"), count: q<SVGTextElement>("demo-count"), next: q<SVGElement>("demo-next"), out: q<SVGTextElement>("demo-out") }
    const slots = [1, 2].map((n) => ({ group: q<SVGElement>(`demo-v${n}`), name: q<SVGTextElement>(`demo-n${n}`), value: q<SVGTextElement>(`demo-x${n}`) }))
    let previous: Step | undefined
    const show = (index: number) => {
      const step = steps[index]
      if (step === undefined) return
      demo.hl?.setAttribute("style", `transform: translateY(${88 + (step.line - 1) * 36}px)`)
      if (demo.count) demo.count.textContent = `${index + 1} / ${steps.length}　main　${step.line} 行目（この行を実行する前）`
      slots.forEach((slot, i) => {
        const row = step.vars[i]
        slot.group?.setAttribute("opacity", row === undefined ? "0" : "1")
        if (row === undefined || !slot.name || !slot.value) return
        slot.name.textContent = row[0]
        const changed = previous?.vars[i]?.[1] !== row[1]
        slot.value.textContent = row[1]
        if (changed) {
          slot.value.classList.remove("flash")
          void slot.value.getBoundingClientRect()
          slot.value.classList.add("flash")
        }
      })
      if (demo.out) {
        demo.out.textContent = step.out ?? "（まだ何も出ていません）"
        demo.out.setAttribute("opacity", step.out === undefined ? "0.6" : "1")
      }
      previous = step
    }
    const press = (el: Element | null) => {
      el?.classList.add("press")
      setTimeout(() => el?.classList.remove("press"), 220)
    }
    const demoSvg = document.getElementById("demo")
    if (demoSvg && !reduced) {
      let index = 0
      let visible = false
      new IntersectionObserver((entries) => { visible = entries.some((e) => e.isIntersecting) }, { threshold: 0.4 }).observe(demoSvg)
      show(0)
      setInterval(() => {
        if (!visible) return
        index = (index + 1) % steps.length
        if (index > 0) press(demo.next)
        show(index)
      }, 1500)
    }
  </script>
</Base>
