  </main>
  <script>
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches

    // ---- スクロールで現れる ----
    const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]")
    reveals.forEach((el) => {
      const delay = Number(el.dataset.reveal)
      if (Number.isFinite(delay) && delay > 0) el.style.setProperty("--d", String(delay))
    })
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          entry.target.classList.add("in")
          reveal.unobserve(entry.target)
        }
      },
      { threshold: 0.16, rootMargin: "0px 0px -6% 0px" },
    )
    reveals.forEach((el) => reveal.observe(el))

    // ---- ステップ実行のデモ（見えているあいだ、1歩ずつ進める）----
    type Row = readonly [string, string]
    interface Step { readonly line: number; readonly vars: readonly Row[]; readonly out?: string }
    const steps: readonly Step[] = [
      { line: 2, vars: [] },
      { line: 3, vars: [["total", "0"]] },
      { line: 4, vars: [["total", "0"], ["i", "0"]] },
      { line: 4, vars: [["total", "0"], ["i", "1"]] },
      { line: 4, vars: [["total", "1"], ["i", "2"]] },
      { line: 4, vars: [["total", "3"], ["i", "3"]] },
      { line: 6, vars: [["total", "6"], ["i", "3"]], out: "6" },
    ]
    const q = <T extends Element>(id: string) => document.getElementById(id) as unknown as T | null
    const demo = { hl: q<SVGElement>("demo-hl"), count: q<SVGTextElement>("demo-count"), next: q<SVGElement>("demo-next"), out: q<SVGTextElement>("demo-out") }
    const slots = [1, 2].map((n) => ({ group: q<SVGElement>(`demo-v${n}`), name: q<SVGTextElement>(`demo-n${n}`), value: q<SVGTextElement>(`demo-x${n}`) }))
    let previous: Step | undefined
    const show = (index: number) => {
      const step = steps[index]
      if (step === undefined) return
      demo.hl?.setAttribute("style", `transform: translateY(${96 + (step.line - 1) * 34}px)`)
      if (demo.count) demo.count.textContent = `${index + 1} / ${steps.length}　main　${step.line} 行目（この行を実行する前）`
      slots.forEach((slot, i) => {
        const row = step.vars[i]
        slot.group?.setAttribute("opacity", row === undefined ? "0" : "1")
        if (row === undefined || !slot.name || !slot.value) return
        slot.name.textContent = row[0]
        const changed = previous?.vars[i]?.[1] !== row[1]
        slot.value.textContent = row[1]
        if (changed) {
          slot.value.classList.remove("flash")
          void slot.value.getBoundingClientRect()
          slot.value.classList.add("flash")
        }
      })
      if (demo.out) {
        demo.out.textContent = step.out ?? "（まだ何も出ていません）"
        demo.out.setAttribute("opacity", step.out === undefined ? "0.6" : "1")
      }
      previous = step
    }
    const press = (el: Element | null) => {
      el?.classList.add("press")
      setTimeout(() => el?.classList.remove("press"), 220)
    }
    const demoSvg = document.getElementById("demo")
    if (demoSvg && !reduced) {
      let index = 0
      let visible = false
      new IntersectionObserver((entries) => { visible = entries.some((e) => e.isIntersecting) }, { threshold: 0.4 }).observe(demoSvg)
      show(0)
      setInterval(() => {
        if (!visible) return
        index = (index + 1) % steps.length
        if (index > 0) press(demo.next)
        show(index)
      }, 1500)
    }
  </script>
