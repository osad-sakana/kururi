---
import iconUrl from "../../../../assets/logo/kururi-icon.svg?url"

const base = import.meta.env.BASE_URL
const home = base.endsWith("/") ? base : `${base}/`
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>プレイグラウンド | Kururi</title>
    <meta name="description" content="Kururi をブラウザで書いて、Python に変換し、その場で実行できます。" />
    <link rel="icon" type="image/svg+xml" href={iconUrl} />
    <!-- narapy と同じ書体: BIZ UDPGothic（画面）と 0xProto（コード） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=0xProto:ital,wght@0,400;0,700;1,400&family=BIZ+UDPGothic:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <!-- input() の入力待ちに SharedArrayBuffer を使う。公開先でも動くよう、必要なヘッダーをサービスワーカーで付ける（MIT） -->
    <script is:inline src={`${home}coi-serviceworker.js`}></script>
  </head>
  <body class="playground">
    <header>
      <a class="brand" href={home} aria-label="Kururi のトップへ"><h1 aria-label="Kururi"></h1></a>
      <nav class="site-links" aria-label="サイト内">
        <a href={`${home}tutorials`}>チュートリアル</a>
      </nav>
      <label class="visually-hidden" for="samples">サンプル</label>
      <select id="samples" title="サンプルを選ぶと、エディタの中身が入れ替わります（元に戻せます）"></select>
      <span id="status" role="status"></span>
      <div class="controls" role="group" aria-label="文字の大きさ">
        <button id="font-down" type="button" aria-label="文字を小さくする" title="文字を小さくする">A−</button>
        <span id="font-size" aria-live="polite"></span>
        <button id="font-up" type="button" aria-label="文字を大きくする" title="文字を大きくする">A＋</button>
      </div>
      <button id="theme" type="button" title="見た目を切り替える（自動 / ライト / ダーク）"></button>
      <button id="run" class="primary" type="button" disabled>実行</button>
      <button id="step" type="button" disabled title="1 行ずつ進めながら、変数の値を見る">ステップ実行</button>
      <button id="stop" type="button" hidden>止める</button>
      <button id="open-narapy" type="button" disabled>narapy で開く</button>
    </header>
    <main>
      <section aria-label="Kururi">
        <div class="pane-title">KURURI</div>
        <div id="editor"></div>
      </section>
      <section aria-label="Python と実行結果" class="right">
        <div class="pane-title">PYTHON（編集できません）</div>
        <div id="python" aria-label="Python（編集できません）"></div>
        <div class="pane-title">実行結果</div>
        <div id="console">
          <ul id="problems" aria-label="問題の一覧" hidden></ul>
          <div id="stepper" hidden></div>
          <pre id="output" aria-label="実行結果" aria-live="polite"></pre>
        </div>
      </section>
    </main>
    <script>
      import "../playground/main"
    </script>
  </body>
</html>
