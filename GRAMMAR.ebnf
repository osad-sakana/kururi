(* ============================================================
   Kururi 文法 草案 v0.4（関数はすべて式。for は n times。範囲 .. をやめた）

   記法
     =        定義          |      または
     { X }    0回以上       [ X ]  省略可能
     ( X )    グループ      "x"    そのままの文字列（トークン）
     (* … *)  コメント
     大文字   字句（トークン）  小文字  構文規則
   ============================================================ *)


(* ------------------------------------------------------------
   1. 字句
   ------------------------------------------------------------ *)

(* 空白（スペース・タブ）はトークンの区切りで、それ以外に意味を持たない。
   改行は NL トークンになり、「文の終わり」を表す。 *)

(* 1-1. NL の扱い（字句解析器が行う。文法の外の規則。上から順に適用する）

     ( ) と [ ] の深さを数える。{ } は深さに数えない（文のブロックのため）。

     1. 深さが 1 以上のあいだ、NL はすべて捨てる。
          （複数行の引数・配列リテラルで、行頭に演算子があってもよい）
     2. 深さが 0 のとき、直前のトークンが次のどれかなら NL を捨てる（次の行へ続く）。
          二項演算子（行末の "-" は常に二項演算子として扱う）/ 代入演算子 / "," / "."
          ※ "{" の直後の NL は捨てない（文法の { NL } が受ける）。
     3. 直前のトークンが "}" で、次のトークンが "else" のとき、NL を捨てる（else if は "else" "if" の 2 語）。
     4. "}" の直前に NL がなければ補う（{ return 1 } のような 1 行ブロックのため）。
          ※ 文字列補間の ${ ... } を閉じる "}" は対象外。
     5. 連続する NL は 1 つにまとめる。
     6. 行頭が演算子の行は、深さ 0 では前の行の続きにならない（新しい文として扱う）。 *)

(* 名前の書き方の決まり（宣言の名前だけを検査する。違反は K0506）
     クラス名: 先頭が大文字で "_" を含まない（アッパーキャメルケース）
     const の名前: 小文字を含まない（大文字のスネークケース）
     それ以外（var・関数・method・引数・フィールド・ループ変数）: 大文字を含まない（スネークケース）
     英字を含まない名前（日本語など）は対象外 *)
IDENT     = idStart { idContinue } ;
                (* idStart / idContinue は Python の XID_Start / XID_Continue に揃える
                   （ひらがな・カタカナ・漢字・ASCII の英字と "_"。数字は ASCII の 0〜9 のみ）。
                   予約語は除く。"__" で始まる名前は使えない。
                   NFKC 正規化で形が変わる文字（全角英数字・半角カナなど）はエラー *)

INT       = "0" | nonZeroDigit { digit } ;               (* 007 は書けない *)
FLOAT     = INT "." digit { digit } ;
digit     = "0" … "9" ;
nonZeroDigit = "1" … "9" ;

(* 文字列。"..." の中の ${式} は補間になる。中の式は通常の expr（入れ子の文字列も書ける）。
   字句解析器は、"${" で通常モードに戻って式を読み、対応する "}"（入れ子の深さで判定）で文字列に戻る。
   補間は "${" の並びだけが始まりで、"{" "}" "$" 単独はそのまま文字として書ける。
   文字として "${" と書きたいときは "\${" と書く。
   補間のない文字列は、ふつうの文字列と同じ。文字列は 1 行の中に書く。
   旧 バッククォートの文字列（`...`）は K0114 で案内する。 *)
STRING    = '"' { stringChar | escape | "${" expr "}" } '"' ;
escape    = "\" ( '"' | "\" | "$" | "n" | "t" ) ;       (* これ以外のエスケープはエラー *)

(* コメント：  // 行末まで    /* 次の */ まで（入れ子なし） *)

(* 予約語（IDENT にできない）
   const var function method return class public private new constructor self
   if else while for in times break continue
   （古い書き方の案内用に let repeat foreach elseif void も予約語のまま残す）
   true false null and or not
   int float string boolean
   組み込み名: print input to_string to_int to_float div random（配列は push remove_at length） *)


(* ------------------------------------------------------------
   2. プログラム全体
   ------------------------------------------------------------ *)

program      = { NL } { topLevel { NL } } EOF ;
topLevel     = functionDecl | classDecl | varDecl ;
                (* main の存在と形 function main = () { } は意味検査で確認 *)


(* ------------------------------------------------------------
   3. 型
   ------------------------------------------------------------ *)

type         = baseType [ "?" ] { "[" "]" [ "?" ] } ;
                (* string?   string[]   string[]?   string?[]   int[][] *)
baseType     = "int" | "float" | "string" | "boolean" | "null" | IDENT ;
                (* IDENT はクラス名。null は「null だけを入れられる型」で、値を返さない関数の型 *)
returnType   = type ;


(* ------------------------------------------------------------
   4. 宣言
   ------------------------------------------------------------ *)

varDecl      = ( "var" | "const" ) IDENT ":" type "=" expr NL ;

functionDecl = "function" IDENT "=" "(" [ params ] ")" [ "->" returnType ] block ;
                (* "->" を省くと、null を返す関数（戻り値なし）になる。
                   関数の呼び出しはすべて式で、評価すると値になる。値を返さない関数（print など）は null になる。
                   旧 "-> void" は K0114 で案内する。
                   main だけは特別：引数なし・戻り値なしで、"->" は書けない（K0207） *)
params       = param { "," param } ;
param        = IDENT ":" type ;

classDecl    = "class" IDENT "=" "{" { NL } [ fieldsDecl ] { member { NL } } "}" ;
                (* fields は 1 回だけ、constructor と method より前に書く *)
fieldsDecl   = "fields" "=" "{" { NL } { fieldDecl { NL } } "}" NL ;
                (* fields は予約語ではない（クラスの直下でだけ特別な意味を持つ） *)
member       = constructorDecl | methodDecl ;
access       = "public" | "private" ;                 (* 省略すると private *)
fieldDecl    = [ access ] IDENT ":" type [ "=" expr ] NL ;
constructorDecl = "constructor" "=" "(" [ params ] ")" block ;      (* 常に外から呼べる。access は付けられない *)
methodDecl   = [ access ] "method" IDENT "=" "(" [ params ] ")" [ "->" returnType ] block ;


(* ------------------------------------------------------------
   5. 文
   ------------------------------------------------------------ *)

block        = "{" { NL } { statement { NL } } "}" ;

statement    = varDecl
             | simpleStmt NL
             | ifStmt
             | whileStmt
             | forStmt
             | returnStmt NL
             | "break" NL
             | "continue" NL ;

(* 文の 4 つの種類（呼び名）
     式文        式だけの文（print("a")、xs.push(1)）
     宣言代入文  名前に値を入れる文（var / const の宣言、代入）
     ブロック文  式とブロックでできた文（if、while、for）。ブロックの中に文を入れられる
     ジャンプ文  流れを飛ばす文（return、break、continue）
   プログラムは、宣言（function / class / トップレベルの var・const）の並びで、関数の中は文の並び。 *)

(* 代入 または 式文。
   意味検査:  代入の左辺は 変数 / a[i] / a.b のみ。
              式文は、どの式でも書ける。関数・メソッドの呼び出し以外は、値が使われないので警告（K0603）。
              x += 1 は x = x + 1 と同じ（左辺は 1 回だけ評価）。型は x = x + 1 と同じ規則で検査する
              （例: int の x に x /= 2 は float になるのでエラー）。
              a == b = c のように、比較が代入の左辺になっているときは
              「== は比べる記号です。代入は =」と案内する。 *)
simpleStmt   = expr [ assignOp expr ] ;
assignOp     = "=" | "+=" | "-=" | "*=" | "/=" | "%=" ;

returnStmt   = "return" [ expr ] ;

(* 条件の位置に assignOp が来たとき（if x = 1 { ）は、構文エラーとして
   「条件には == を使います。= は代入です」と案内する。 *)
ifStmt       = "if" expr block { "else" "if" expr block } [ "else" block ] ;
whileStmt    = "while" expr block ;

(* for は 2 通り。IDENT は新しい変数で、読み取り専用。ループの外では使えない。
   回数: for i n times { }   i は int で、0 から n - 1。n は int の式で、ループに入るとき 1 回だけ評価する
                              （Python の for i in range(n) に対応）。n が 0 以下なら 1 回も回らない。
                              旧 for i in a..b は K0114 で案内する。
   配列: for x in xs { }     x の型は要素の型から決まる。 *)
forStmt      = "for" IDENT ( expr "times" | "in" expr ) block ;


(* ------------------------------------------------------------
   6. 式（優先順位は Python に準拠。上ほど弱く、下ほど強い）
   ------------------------------------------------------------ *)

expr           = orExpr ;
orExpr         = andExpr { "or" andExpr } ;
andExpr        = notExpr { "and" notExpr } ;
notExpr        = "not" notExpr | comparison ;

(* [ ] なので a < b < c は構文エラーになる。
   パーサーはここで「比較は連鎖できません。a < b and b < c と書いてください」と案内する。 *)
comparison     = additive [ compareOp additive ] ;
compareOp      = "==" | "!=" | "<" | "<=" | ">" | ">=" ;

additive       = multiplicative { ( "+" | "-" ) multiplicative } ;
multiplicative = unary { ( "*" | "/" | "%" ) unary } ;
unary          = "-" unary | postfix ;

postfix        = primary { call | index | member } ;
call           = "(" [ args ] ")" ;
index          = "[" expr "]" ;
member         = "." IDENT ;                        (* a.length / a.push(x) / pl.run() / self.name *)
args           = expr { "," expr } ;

primary        = INT | FLOAT | STRING
               | "true" | "false" | "null" | "self"
               | IDENT
               | "(" expr ")"
               | arrayLiteral
               | newExpr ;

newExpr        = "new" IDENT "(" [ args ] ")" ;     (* コンストラクタを呼ぶ。() は必須 *)
arrayLiteral   = "[" [ expr { "," expr } [ "," ] ] "]" ;   (* 末尾カンマ可。改行は NL 規則 1 で吸収 *)


(* ------------------------------------------------------------
   7. 文法では表せない検査（意味検査。エラーメッセージの対象）
   ------------------------------------------------------------
   型
   - 型の一致（代入、引数、戻り値、演算。int→float のみ暗黙変換可。配列は型が一致するものだけ）
   - T? を T として使う誤り（if x != null の中は T として可）
   - 空の配列 [] を、型が決まらない場所で使った
   - オブジェクト（オブジェクトの入った配列を含む）を print / to_string / 補間に渡した（配列は表示できる）
   - 文字列の要素への代入（s[i] = ...）
   - 添字に負の整数リテラル（a[-1]）
   - T? の絞り込み範囲の外で T として使った
       絞り込めるのは、ローカル変数・引数と、そこから . でたどったフィールド（x、self.next、a.b）。
       代入されたとき、メソッドや自作の関数を呼んだとき（フィールドのみ）に外れる。トップレベルの変数は絞り込まない
   - null を返す関数（戻り値なし）以外で return が抜けている（T? の関数も含む）
   - for の回数が int でない
   - 添字（a[i]・a[i] = …・remove_at(i)）：負の数のリテラルはエラー（K0315）。
       変数や式が負になるかは、実行時に検査する（式の形から 0 以上と分かるときは検査を省く）
   警告（エラーではない。warnings を頼んだときだけ返す）
   - K0601 使っていない変数 / K0602 実行されない行
   - K0603 値を使わない式を、文として単独で書いた（呼び出しは対象外）
   - K0604 値を返さない関数（null になる呼び出し）の値を、代入・引数・演算などで使った
   名前・スコープ
   - const の再代入禁止 / for の変数への代入禁止
   - 関数内でのシャドーイング（引数・ローカル・トップレベルと同名の宣言）
       兄弟のブロックでの再宣言は、型が同じ場合のみ可
   - 変数のスコープ外の使用
   - クラスを定義より前の行で型や new に使った（自分自身の本体の中は可）
   - トップレベルの変数の初期値に自作の関数・クラスを使った
   - main の有無と形 (function main = () { }) / main を呼び出した
   - self をクラスの外で使った
   予約語・識別子
   - 予約語 / Python予約語を識別子に使った
   - 古い書き方（let / repeat / foreach / elseif）の案内（K0114）。for (…; …; …) も同様
   - NFKC 正規化で形が変わる識別子（全角英数字・半角カナなど）、"__" で始まる識別子
   - 同じクラスでフィールドとメソッドが同名
   クラス
   - private / public のアクセス違反
   - 初期値のない T? 以外のフィールドを constructor が代入していない
   ------------------------------------------------------------ *)
